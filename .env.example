# Copy to .env and fill in. All values can also be set as environment
# variables (same names); see src/monty_claw/config.py for defaults.

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather (required for `poll`, `serve`, `set-webhook`).
TELEGRAM_BOT_TOKEN=123456789:AAF...your-token-here
# Shared secret echoed back by Telegram in the X-Telegram-Bot-Api-Secret-Token
# header; webhook requests without it are rejected. Generate with:
#   openssl rand -hex 32
# Leave empty to disable the check (long-polling/local dev only).
TELEGRAM_SECRET_TOKEN=

# --- LLM (any OpenAI-compatible endpoint) -----------------------------------
# Defaults target local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=minimax-m3:cloud
LLM_API_KEY=ollama

# --- Database (MongoDB) — history, dedupe, blob pointers --------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=monty_claw

# --- Blob storage — agent message history (the assistant's memory) ----------
# 'local' writes under LOCAL_STORAGE_DIR; 'gcs' needs GCS_BUCKET and
# Application Default Credentials (gcloud auth application-default login).
STORAGE_BACKEND=local
GCS_BUCKET=
LOCAL_STORAGE_DIR=.monty_claw_state

# --- Public URL -------------------------------------------------------------
# Origin of this deployment, used to build shareable links to generated images
# (served from /media/...). Leave empty and those links are site-relative.
#PUBLIC_BASE_URL=https://monty-claw-xxxx.a.run.app

# --- Web UI (chat + configuration page at /) --------------------------------
# Disabled unless BOTH are set. Login is username & password.
WEB_USERNAME=
WEB_PASSWORD=
# Cookie-signing secret (openssl rand -hex 32); derived from the credentials
# if left empty. Set it explicitly so sessions survive password changes.
WEB_SECRET_KEY=
#WEB_SESSION_TTL_SECS=2592000

# --- Agent engine knobs (defaults shown; usually fine) ----------------------
# Model requests allowed per turn.
#MAX_ITERATIONS=8
# Nested tool calls one run_code snippet may dispatch.
#MAX_TOOL_CALLS=100
#HISTORY_MAX_TURNS=20
#MONTY_MAX_DURATION_SECS=30.0
#MONTY_MAX_MEMORY=209715200
# Keep below Telegram's ~60s webhook patience.
#TURN_DEADLINE_SECS=50.0

# --- Server -----------------------------------------------------------------
# Cloud Run injects PORT automatically; only set for local `serve`.
#PORT=8080

GEMINI_API_KEY=
